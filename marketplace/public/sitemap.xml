<?xml version="1.0" encoding="UTF-8"?>
<!-- 공개 문서 페이지만 싣는다. /api/* 는 크롤 대상이 아니고, /status 는 열 때마다
     API 를 호출하므로 색인시키지 않는다(robots.txt 와 같은 판단). 경로는 상대이며
     호스트가 정해지면 절대 URL 로 바꾼다. -->
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
  <url><loc>/</loc><changefreq>weekly</changefreq><priority>1.0</priority></url>
  <url><loc>/catalog</loc><changefreq>daily</changefreq><priority>0.9</priority></url>
  <url><loc>/docs</loc><changefreq>monthly</changefreq><priority>0.8</priority></url>
  <url><loc>/guide</loc><changefreq>monthly</changefreq><priority>0.7</priority></url>
  <url><loc>/support</loc><changefreq>monthly</changefreq><priority>0.5</priority></url>
  <url><loc>/legal</loc><changefreq>monthly</changefreq><priority>0.4</priority></url>
</urlset>
