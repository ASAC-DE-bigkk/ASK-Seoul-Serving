{
  "openapi": "3.1.0",
  "info": {
    "title": "ASK: SEOUL 데이터 API",
    "version": "1.3.0",
    "summary": "서울 공공데이터를 시간·공간 같은 축 위에 올린 읽기 전용 REST API",
    "description": "서울시·기상청·행정안전부 등의 공개 데이터를 수집·정제해 6개 도메인(문화·행사 / 인구·도시 / 상권 / 대중교통 / 도로 소통 / 날씨)의 데이터 제품으로 제공한다. 원천을 그대로 중계하지 않는 2차 가공물이며, 수치가 원천 제공기관의 공식 발표와 다를 수 있다.\n\n학습·연구 목적의 프로젝트라 가용성을 보장하지 않는다.",
    "termsOfService": "/terms",
    "contact": { "name": "문의", "url": "/support" },
    "license": { "name": "원천별 이용조건을 따름 — /attribution 참조", "url": "/attribution" }
  },
  "externalDocs": { "description": "사람용 API 문서", "url": "/docs" },
  "servers": [{ "url": "/", "description": "이 문서를 서빙 중인 호스트 — dev·production 어느 환경에서도 그 환경 자신을 가리키도록 상대 경로를 유지한다" }],
  "tags": [
    { "name": "catalog", "description": "제품 목록과 스키마 — 인증 불필요" },
    { "name": "data", "description": "데이터 조회 — 인증 필요" },
    { "name": "keys", "description": "API 키 발급·폐기·삭제" },
    { "name": "mcp", "description": "MCP 서버 — JSON-RPC 2.0 단일 엔드포인트" }
  ],
  "security": [{ "bearerAuth": [] }],
  "paths": {
    "/api/v1/catalog": {
      "get": {
        "tags": ["catalog"],
        "summary": "공개 제품 목록",
        "description": "공개 중인 전 제품의 메타데이터(스키마·행 수·시간축·발행 시각·조인 축)를 돌려준다. 클라이언트가 캐시해 두고 쓰기 적합하다.",
        "operationId": "getCatalog",
        "security": [],
        "responses": {
          "200": {
            "description": "제품 목록",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Catalog" } } }
          }
        }
      }
    },
    "/api/v1/search": {
      "get": {
        "tags": ["catalog"],
        "summary": "질문 문장으로 제품 찾기",
        "description": "질문을 그대로 넣으면 답할 수 있는 제품 후보를 최대 3개 돌려준다. 데이터를 조회하지 않고 카탈로그만 읽으므로 키도 일일 한도도 필요 없다(분당 한도는 IP 기준). 각 후보에 왜 골랐는지(matched_terms)와 바로 실행할 수 있는 질의 패턴이 함께 온다. MCP 의 search_products 와 같은 검색기라 사람이 보는 순위와 에이전트가 보는 순위가 갈리지 않는다.",
        "operationId": "searchProducts",
        "security": [],
        "parameters": [
          {
            "name": "q", "in": "query", "required": true,
            "description": "질문 문장. 200자까지.",
            "schema": { "type": "string", "maxLength": 200 },
            "example": "이번 주말에 갈 만한 전시 있어?"
          }
        ],
        "responses": {
          "200": {
            "description": "제품 후보",
            "content": { "application/json": { "schema": {
              "type": "object",
              "properties": {
                "query": { "type": "string" },
                "total_products": { "type": "integer" },
                "matched": { "type": "integer" },
                "products": { "type": "array", "items": { "type": "object", "additionalProperties": true } },
                "hint": { "type": "string", "description": "다음에 부를 것을 알려 주는 한 줄 안내" }
              }
            } } }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "429": { "$ref": "#/components/responses/TooManyRequests" }
        }
      }
    },
    "/api/v1/preview/{product_id}": {
      "get": {
        "tags": ["catalog"],
        "summary": "샘플 5행 미리보기",
        "description": "인증 없이 고정 5행을 돌려준다. 필터를 받지 않고 일일 한도를 소모하지 않는다. 시간축이 있는 제품은 최신 구간을 보여준다. 분당 한도는 IP 기준.",
        "operationId": "getPreview",
        "security": [],
        "parameters": [{ "$ref": "#/components/parameters/Table" }],
        "responses": {
          "200": {
            "description": "샘플 행",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "table": { "type": "string" },
                    "preview": { "type": "boolean", "const": true },
                    "row_count": { "type": "integer" },
                    "rows": { "type": "array", "items": { "type": "object", "additionalProperties": true } }
                  }
                }
              }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "404": { "$ref": "#/components/responses/NotFound" },
          "429": { "$ref": "#/components/responses/TooManyRequests" }
        }
      }
    },
    "/api/v1/products/{product_id}": {
      "get": {
        "tags": ["catalog"],
        "summary": "제품 하나의 전체 메타",
        "description": "한 제품의 컬럼 설명·그레인·기본키·시간축·신선도와 **검증된 질의 패턴 목록**을 한 번에 돌려준다. /api/v1/catalog 가 전 제품의 얕은 목록이라면 이쪽은 한 제품의 깊은 설명이라, 조회 전에 한 번 부르면 필터에 쓸 컬럼과 쓸 수 있는 패턴을 함께 확인할 수 있다.\n\n메타 조회라 **일일 한도를 소모하지 않는다**(분당 한도만 적용). ETag 는 publication_id 라, If-None-Match 로 되물으면 내용이 그대로일 때 304 를 돌려준다.\n\n보조 메타는 도메인별 게시 진도가 달라 없을 수 있다 — 없는 조각은 meta.unavailable 에 이름으로 알린다(빈 배열로 덮지 않는다).",
        "operationId": "getProductBundle",
        "parameters": [{ "$ref": "#/components/parameters/Table" }],
        "responses": {
          "200": {
            "description": "제품 메타 번들",
            "headers": {
              "ETag": { "schema": { "type": "string" }, "description": "이 제품의 publication_id. 내용이 바뀔 때만 값이 바뀐다" },
              "X-Request-Id": { "$ref": "#/components/headers/XRequestId" }
            },
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ProductBundle" } } }
          },
          "304": { "description": "If-None-Match 가 현재 ETag 와 같다 — 본문 없음" },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "404": { "$ref": "#/components/responses/NotFound" },
          "429": { "$ref": "#/components/responses/TooManyRequests" }
        }
      }
    },
    "/api/v1/glossary": {
      "get": {
        "tags": ["catalog"],
        "summary": "코드값 용어 사전",
        "description": "제품 응답에 숫자·약어로 들어오는 코드값의 뜻을 돌려준다(예: 요일 코드, 혼잡도 등급).\n\n메타 조회라 **일일 한도를 소모하지 않는다**(분당 한도만 적용).\n\nvocabulary_id 없이 부르면 **어휘 목록**(vocabulary_id·origin·수록 용어 수)을 돌려준다 — 거기서 값을 골라 다시 부르면 된다(#180 로 열린 경로. 그전에는 400 이라 어휘 이름을 이미 아는 경우에만 쓸 수 있었다).",
        "operationId": "getGlossary",
        "parameters": [{
          "name": "vocabulary_id", "in": "query", "required": false,
          "description": "어휘 식별자. 생략하면 어휘 목록을 돌려준다.",
          "schema": { "type": "string" },
          "example": "commerce:major"
        }],
        "responses": {
          "200": {
            "description": "어휘의 전 코드값",
            "headers": { "X-Request-Id": { "$ref": "#/components/headers/XRequestId" } },
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "vocabulary_id": { "type": "string" },
                    "terms": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "code": { "type": "string" },
                          "label_ko": { "type": "string" },
                          "origin": { "type": ["string", "null"] },
                          "source_type": { "type": ["string", "null"] }
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "404": { "$ref": "#/components/responses/NotFound" },
          "429": { "$ref": "#/components/responses/TooManyRequests" },
          "503": {
            "description": "glossary unavailable — 용어 사전이 아직 게시되지 않았다",
            "content": { "application/problem+json": { "schema": { "$ref": "#/components/schemas/Problem" } } }
          }
        }
      }
    },
    "/api/v1/data/{product_id}": {
      "get": {
        "tags": ["data"],
        "summary": "데이터 조회",
        "description": "필터·기간·커서 페이지네이션을 지원한다. 정렬은 지정할 수 없고 항상 내부 저장 순서로 고정된다 — 이것이 커서가 행을 빠뜨리지 않는 근거다.\n\n스키마에 없는 쿼리 파라미터는 모두 해당 컬럼의 일치 필터로 해석된다(예: ?gu_code=11110).",
        "operationId": "getData",
        "parameters": [
          { "$ref": "#/components/parameters/Table" },
          {
            "name": "limit", "in": "query",
            "description": "한 번에 받을 행 수. 최대치를 넘겨 보내면 5000으로 잘린다.",
            "schema": { "type": "integer", "default": 500, "minimum": 1, "maximum": 5000 }
          },
          {
            "name": "from", "in": "query",
            "description": "제품의 time_axis 컬럼 이상. time_axis 가 없는 제품이면 400 no time axis.",
            "schema": { "type": "string" }, "example": "2026-08-01"
          },
          {
            "name": "to", "in": "query",
            "description": "제품의 time_axis 컬럼 이하.",
            "schema": { "type": "string" }, "example": "2026-08-31"
          },
          {
            "name": "cursor", "in": "query",
            "description": "이전 응답의 next_cursor 를 그대로 넣는다. 그 사이 제품이 재발행되면 409 cursor expired.",
            "schema": { "type": "string" }
          }
        ],
        "responses": {
          "200": {
            "description": "조회 결과",
            "headers": {
              "X-Request-Id": { "$ref": "#/components/headers/XRequestId" },
              "X-RateLimit-Limit": { "schema": { "type": "integer" }, "description": "일일 한도" },
              "X-RateLimit-Remaining": { "schema": { "type": "integer" }, "description": "오늘 남은 호출 수" },
              "X-RateLimit-Reset": { "schema": { "type": "integer" }, "description": "한도 초기화 시각(Unix epoch 초, KST 자정)" }
            },
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/DataPage" } } }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "404": { "$ref": "#/components/responses/NotFound" },
          "409": { "$ref": "#/components/responses/Conflict" },
          "429": { "$ref": "#/components/responses/TooManyRequests" }
        }
      }
    },
    "/api/v1/patterns/{product_id}/{pattern_id}": {
      "get": {
        "tags": ["data"],
        "summary": "검증된 질의 패턴 실행",
        "description": "도메인 오너가 게시하고 실제 게시본에 돌려 동작을 확인한 SQL 만 실행한다 — 질의를 이 API 로 '짓는' 방법은 없다. 그래서 /api/v1/data 로는 못 하는 집계·랭킹·시계열이 여기서는 된다.\n\n패턴 목록은 카탈로그 각 제품의 usage_patterns 에 있다. runnable=true 인 것만 실행되고, 아직 검증 전이면 409 pattern not verified.\n\n스키마에 없는 쿼리 파라미터는 패턴 SQL 의 :이름 자리에 그대로 바인딩된다(예: ?gu=강남구&n=10). 선언되지 않은 이름을 보내면 400 unknown parameter 가 사용 가능한 파라미터 목록과 함께 온다.\n\n파라미터 계약(#217): 제품 번들(/api/v1/products/{product_id})의 각 패턴에 param_defaults 가 있으면 그 파라미터는 **생략 가능**하고 생략 시 그 기본값으로 실행된다. param_enum 이 있으면 허용값 밖은 400 이다(조용한 0행이 아니라 목록을 알려 준다). params 선언이 array 인 파라미터는 JSON 배열 문자열로 보낸다(예: ?gus=[\"강남구\",\"서초구\"]) — 원소별로 안전하게 바인딩된다. 게시된 SQL 이 게이트웨이 내부 표를 읽으면 실행 전에 400 pattern out of scope 로 거부된다(소비자 잘못이 아니라 게시 오류다).",
        "operationId": "runPattern",
        "parameters": [
          { "$ref": "#/components/parameters/Table" },
          {
            "name": "pattern_id",
            "in": "path",
            "required": true,
            "description": "카탈로그 usage_patterns[].pattern_id.",
            "schema": { "type": "string", "pattern": "^[a-z0-9_]+$" },
            "example": "exhibition_dongs"
          }
        ],
        "responses": {
          "200": {
            "description": "패턴 실행 결과. insight_sample_ko 는 이 질의를 검증 시점에 실제로 돌렸을 때 나온 해석 문장이며 현재값이 아니다.",
            "headers": { "X-Request-Id": { "$ref": "#/components/headers/XRequestId" } },
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "product_id": { "type": "string" },
                    "pattern_id": { "type": "string" },
                    "question_ko": { "type": "string", "description": "이 패턴이 답하는 질문" },
                    "rows": { "type": "array", "items": { "type": "object" } },
                    "row_count": { "type": "integer" },
                    "insight_sample_ko": { "type": "string", "description": "검증 증거 — 현재값이 아니다" }
                  }
                }
              }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "404": { "$ref": "#/components/responses/NotFound" },
          "409": { "$ref": "#/components/responses/Conflict" },
          "429": { "$ref": "#/components/responses/TooManyRequests" }
        }
      }
    },
    "/api/v1/me": {
      "get": {
        "tags": ["keys"],
        "summary": "내 키의 오늘 사용량",
        "operationId": "getMe",
        "responses": {
          "200": {
            "description": "사용량",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "key_prefix": { "type": "string" },
                    "email": { "type": "string", "format": "email" },
                    "day": { "type": "string", "description": "KST 기준 날짜" },
                    "used_today": { "type": "integer" },
                    "daily_quota": { "type": "integer" }
                  }
                }
              }
            }
          },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "429": { "$ref": "#/components/responses/TooManyRequests" }
        }
      }
    },
    "/api/v1/auth/google": {
      "get": {
        "tags": ["keys"],
        "summary": "Google 로그인으로 키 발급 시작",
        "description": "브라우저로 여는 주소다. Google 로 로그인하면 이메일 소유를 Google 이 확인해 주고, 확인된 주소로 키가 발급된다. 키는 콜백 화면에 한 번만 표시되며 URL 에는 절대 실리지 않는다. 사람의 브라우저 왕복이 필요하므로 자동화로는 받을 수 없다 — 에이전트는 운영자에게 키를 받아 설정에 넣는 것이 정상 경로다.",
        "operationId": "startGoogleAuth",
        "security": [],
        "responses": {
          "302": { "description": "Google 로그인 화면으로 이동" },
          "503": {
            "description": "oauth disabled(GOOGLE_CLIENT_ID·GOOGLE_CLIENT_SECRET 미설정) · issuance disabled(ISSUANCE_SALT 미설정) — 이 배포에는 발급 경로가 열려 있지 않다. 이메일 발급은 폐지돼 대안이 아니다(POST /api/v1/keys 는 403).",
            "content": { "application/problem+json": { "schema": { "$ref": "#/components/schemas/Problem" } } }
          }
        }
      }
    },
    "/api/v1/keys/rotate": {
   "post": {
    "tags": [
     "keys"
    ],
    "summary": "키 재발급(회전) — 확인 페이지의 버튼이 보내는 폼",
    "description": "브라우저 폼 전용이다. 이미 키가 있는 계정으로 로그인하면 확인 화면이 뜨고, 그 화면이 실어 준 짧은 증표(10분)를 이 경로로 보내면 새 키가 발급된다. 이전 키는 그 순간 무효가 되고, 그날 쓴 호출 수는 새 키로 이어진다(재발급이 쿼터 초기화가 되지 않게). 재발급은 한 계정당 하루 5회다. 자동화로는 받을 수 없다 — 사람의 브라우저 왕복과 확인이 전제다.",
    "operationId": "rotateKey",
    "security": [],
    "requestBody": {
     "required": true,
     "content": {
      "application/x-www-form-urlencoded": {
       "schema": {
        "type": "object",
        "required": [
         "ticket"
        ],
        "properties": {
         "ticket": {
          "type": "string",
          "description": "확인 화면이 실어 준 증표. 현재 키에 묶여 있어 한 번만 쓸 수 있다."
         }
        }
       }
      }
     }
    },
    "responses": {
     "201": {
      "description": "새 키 발급 — 원문은 이 화면에만 한 번 표시된다(HTML)"
     },
     "400": {
      "description": "증표가 없거나 10분이 지났다 — 다시 로그인해 새로 시작한다(HTML)"
     },
     "405": {
      "description": "method not allowed — GET 으로는 실행되지 않는다(되돌릴 수 없는 동작이라 확인 없이 실행하지 않는다)"
     },
     "409": {
      "description": "이미 처리된 확인이다(HTML)"
     },
     "429": {
      "description": "하루 재발급 5회 또는 같은 네트워크 시간당 발급 5회를 넘었다(HTML)"
     }
    }
   }
  },
  "/api/v1/keys": {
      "delete": {
        "tags": ["keys"],
        "summary": "키 폐기 · 개인정보 삭제",
        "description": "키를 즉시 무효화한다. purge=true 면 이메일과 사용량 기록까지 삭제한다. 이미 폐기한 키로도 삭제를 요청할 수 있다 — 폐기가 '지울 권리'의 문을 닫아서는 안 되기 때문이다.",
        "operationId": "deleteKey",
        "parameters": [{
          "name": "purge", "in": "query",
          "description": "true 면 이메일·사용량 기록까지 삭제한다.",
          "schema": { "type": "string", "enum": ["true"] }
        }],
        "responses": {
          "200": {
            "description": "폐기 또는 삭제됨",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "key_prefix": { "type": "string" },
                    "revoked": { "type": "boolean" },
                    "purged": { "type": "boolean" },
                    "note": { "type": "string" }
                  }
                }
              }
            }
          },
          "401": { "$ref": "#/components/responses/Unauthorized" }
        }
      }
    },
    "/mcp": {
      "post": {
        "tags": ["mcp"],
        "summary": "MCP 서버 (Streamable HTTP · JSON-RPC 2.0)",
        "description": "Model Context Protocol 서버다. Claude·Cursor 같은 MCP 클라이언트에 등록하면 에이전트가 스스로 제품을 찾아 질의한다. REST 와 **같은 키·같은 한도**를 쓴다.\n\n도구는 여섯 개다 — list_products · describe_product · preview_product · query_product · run_pattern · check_quota. 각 도구의 인자 스키마는 tools/list 응답이 정본이라 여기 중복해 싣지 않는다.\n\n인증 경계: initialize · tools/list 는 키 없이 되고, 데이터를 만지는 **tools/call 부터 키가 필요하다.**\n\n⚠️ **도구 실패는 HTTP 200 이다.** JSON-RPC 는 오류도 봉투에 담으므로, 상태 코드가 아니라 봉투 안의 isError: true 와 그 내용을 읽어야 한다.",
        "operationId": "postMcp",
        "security": [],
        "externalDocs": { "description": "연결 방법과 도구별 설명", "url": "/guide" },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "description": "JSON-RPC 2.0 요청",
                "properties": {
                  "jsonrpc": { "type": "string", "const": "2.0" },
                  "id": { "type": ["string", "integer", "null"] },
                  "method": { "type": "string", "examples": ["initialize", "tools/list", "tools/call"] },
                  "params": { "type": "object", "additionalProperties": true }
                },
                "required": ["jsonrpc", "method"]
              },
              "example": {
                "jsonrpc": "2.0", "id": 1, "method": "tools/call",
                "params": { "name": "run_pattern", "arguments": { "product_id": "culture_activity_by_dong", "pattern_id": "exhibition_dongs", "params": { "n": 10 } } }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "JSON-RPC 응답. 도구 실패도 여기로 온다 — result.isError 를 확인할 것.",
            "headers": { "X-Request-Id": { "$ref": "#/components/headers/XRequestId" } },
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "jsonrpc": { "type": "string", "const": "2.0" },
                    "id": { "type": ["string", "integer", "null"] },
                    "result": { "type": "object", "additionalProperties": true, "description": "도구 실패 시 isError: true 와 안내가 들어 있다" },
                    "error": { "type": "object", "additionalProperties": true, "description": "프로토콜 수준 오류(잘못된 method 등)" }
                  }
                }
              }
            }
          },
          "405": {
            "description": "method not allowed — MCP 는 POST 만 받는다",
            "content": { "application/problem+json": { "schema": { "$ref": "#/components/schemas/Problem" } } }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http", "scheme": "bearer",
        "description": "Authorization: Bearer ask_… — 카탈로그의 인증 영역에서 Google 로그인으로 발급받는다. 사람이 브라우저로 받아 클라이언트 설정에 넣는다."
      }
    },
    "parameters": {
      "Table": {
        "name": "product_id", "in": "path", "required": true,
        "description": "제품 식별자. /api/v1/catalog 응답의 products[].product_id 값이다. 물리 테이블명(products[].name)도 과도기 별칭으로 받는다.",
        "schema": { "type": "string", "pattern": "^[a-z0-9_]+$" },
        "example": "culture_event_schedule"
      }
    },
    "headers": {
      "XRequestId": {
        "schema": { "type": "string", "pattern": "^req_[0-9a-f]{16}$" },
        "description": "이 요청의 식별자. 문의 시 이 값을 알려주면 해당 요청을 특정할 수 있다."
      }
    },
    "schemas": {
      "Catalog": {
        "type": "object",
        "properties": {
          "attribution": { "type": "string", "description": "출처·이용조건 고지" },
          "docs": { "type": "string" },
          "join_axes": {
            "type": "array", "items": { "type": "string" },
            "description": "도메인 간 공통 조인 축"
          },
          "products": { "type": "array", "items": { "$ref": "#/components/schemas/Product" } }
        }
      },
      "Product": {
        "type": "object",
        "properties": {
          "name": { "type": "string", "description": "/api/v1/data 에 넣는 테이블 이름" },
          "product_id": { "type": "string" },
          "external": { "type": "integer", "description": "1 이면 외부 공개" },
          "description": { "type": "string", "description": "그레인과 주의사항이 실린다 — 한계를 아는 데 필요하다" },
          "product_question": { "type": ["string", "null"] },
          "time_axis": { "type": ["string", "null"], "description": "from/to 가 걸리는 컬럼. null 이면 기간 필터 불가" },
          "columns": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": { "name": { "type": "string" }, "type": { "type": "string" } }
            }
          },
          "join_keys": {
            "type": "array", "items": { "type": "string" },
            "description": "이 제품이 실제로 가진 공통 축"
          },
          "row_count": { "type": "integer" },
          "freshness": { "type": ["string", "null"] },
          "exported_at": { "type": ["string", "null"], "format": "date-time", "description": "발행 시각(ISO 8601 UTC). 커서 유효성의 기준 — 화면에 쓸 때 UTC 15:00 이후 값은 한국 날짜로 다음 날이다" }
        }
      },
      "DataPage": {
        "type": "object",
        "properties": {
          "table": { "type": "string" },
          "row_count": { "type": "integer" },
          "limit": { "type": "integer" },
          "time_axis": { "type": ["string", "null"] },
          "has_more": { "type": "boolean" },
          "next_cursor": { "type": ["string", "null"], "description": "has_more 가 true 일 때만 값이 있다" },
          "usage": {
            "type": "object",
            "properties": { "used": { "type": "integer" }, "daily_quota": { "type": "integer" } }
          },
          "rows": { "type": "array", "items": { "type": "object", "additionalProperties": true } }
        }
      },
      "ProductBundle": {
        "type": "object",
        "description": "한 제품의 전체 메타. columns·structure·patterns 는 도메인별 게시 진도가 달라 비어 있을 수 있고, 그때 meta.unavailable 에 어느 조각이 없는지 이름으로 들어온다.",
        "properties": {
          "product_id": { "type": "string" },
          "table_name": { "type": "string", "description": "물리 테이블명. 경로 인자로는 product_id 를 쓴다" },
          "publication_id": { "type": ["string", "null"], "description": "ETag 와 같은 값" },
          "description": { "type": ["string", "null"] },
          "product_question": { "type": ["string", "null"] },
          "freshness": { "type": ["string", "null"] },
          "row_count": { "type": ["integer", "null"] },
          "exported_at": { "type": ["string", "null"], "format": "date-time" },
          "structure": {
            "type": ["object", "null"],
            "properties": {
              "grain": { "type": ["string", "null"] },
              "primary_key": { "type": "array", "items": { "type": "string" } },
              "time_axis": { "type": ["string", "null"] },
              "tier": { "type": ["string", "null"] },
              "rollup_rule": { "type": ["string", "null"] }
            }
          },
          "columns": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "name": { "type": "string" },
                "type": { "type": "string" },
                "description_ko": { "type": ["string", "null"] }
              }
            }
          },
          "patterns": {
            "type": "array",
            "description": "이 제품의 검증된 질의 패턴. GET /api/v1/patterns/{product_id}/{pattern_id} 로 실행한다.",
            "items": {
              "type": "object",
              "properties": {
                "pattern_id": { "type": "string" },
                "question_ko": { "type": ["string", "null"], "description": "이 패턴이 답하는 질문 — 고르는 기준이다" },
                "axes": { "type": ["string", "null"] },
                "requires": { "type": "array", "items": { "type": "string" }, "description": "이 질의가 쓰는 SQL 능력(sort·aggregate·group_by 등)" },
                "verified_rows": { "type": ["integer", "null"] },
                "verified_at": { "type": ["string", "null"], "description": "검증 시각. 두 형태가 섞여 온다 — 'YYYY-MM-DDTHH:MM:SSZ'(UTC) 또는 'YYYY-MM-DD'(날짜만). format 을 date-time 으로 선언하지 않는 이유가 이것이다: 날짜만인 값이 실제로 있어(2026-08-13 실측 122/884) 엄격한 검증기가 그것들을 거절한다" },
                "runnable": { "type": "boolean", "description": "verified_at 파생값. false 면 실행 시 409 pattern not verified — 고르기 전에 걸러 쓰라고 미리 준다" },
                "allow_empty": { "type": "boolean", "description": "0행이 정상인 패턴(이상 감지 스크린 등)" },
                "insight_sample_ko": { "type": ["string", "null"], "description": "검증 당시의 해석 문장 — 현재값이 아니다" },
                "param_defaults": { "type": "object", "additionalProperties": { "type": ["string", "number"] }, "description": "선언된 패턴에만 실린다(#217 P1). 여기 있는 파라미터는 호출 시 생략 가능 — 생략하면 이 값으로 실행된다" },
                "param_enum": { "type": "object", "additionalProperties": { "type": "array", "items": { "type": ["string", "number"] } }, "description": "허용값 집합(#217 P1). 밖의 값은 400 — 센티널 오타가 조용한 0행이 되지 않는다" },
                "params": { "type": "object", "additionalProperties": { "type": "object", "properties": { "type": { "type": "string", "enum": ["string", "number", "array"] }, "item": { "type": "string", "enum": ["string", "number"] }, "max_len": { "type": "integer" } } }, "description": "파라미터 타입 선언(#217 P3). type=array 인 파라미터는 REST 에선 JSON 배열 문자열, MCP 에선 실배열로 보낸다" }
              }
            }
          },
          "meta": {
            "type": "object",
            "properties": {
              "unavailable": {
                "type": "array", "items": { "type": "string", "enum": ["columns", "structure", "patterns"] },
                "description": "게시되지 않은 조각의 이름. 없으면 이 필드 자체가 없다 — '메타가 없다'와 '메타가 비었다'를 구분하기 위해서다"
              },
              "meta_of": {
                "type": "string", "const": "previous_publication",
                "description": "보조 메타가 데이터보다 이전 발행본일 때만 실린다. 무변경 밴드 게이트로 스킵된 제품의 정상 상태이지 오류가 아니다"
              }
            }
          }
        }
      },
      "Problem": {
        "type": "object",
        "description": "RFC 9457(구 7807). status 가 아니라 title 로 분기할 것 — 같은 상태 코드에 원인이 여럿이다.",
        "properties": {
          "type": { "type": "string", "default": "about:blank" },
          "title": { "type": "string", "description": "오류 종류의 안정된 식별자" },
          "status": { "type": "integer" },
          "detail": { "type": "string", "description": "사람이 읽는 설명. 문구는 예고 없이 바뀔 수 있다" },
          "request_id": { "type": "string", "description": "문의 시 알려주면 해당 요청을 특정할 수 있다" },
          "retry_after": { "type": "integer", "description": "burst rate limited 일 때만" }
        }
      }
    },
    "responses": {
      "BadRequest": {
        "description": "invalid id · invalid product id · unknown filter · no time axis · invalid cursor · invalid email · unknown parameter(패턴에 선언되지 않은 이름 — detail 에 쓸 수 있는 이름 목록) · missing parameter(기본값 없는 파라미터 생략) · invalid parameter(타입·허용값 위반) · pattern out of scope(게시 SQL 이 내부 표를 참조 — 게시 오류) · missing vocabulary_id",
        "content": { "application/problem+json": { "schema": { "$ref": "#/components/schemas/Problem" } } }
      },
      "Unauthorized": {
        "description": "missing api key · unknown api key",
        "content": { "application/problem+json": { "schema": { "$ref": "#/components/schemas/Problem" } } }
      },
      "Forbidden": {
        "description": "revoked api key",
        "content": { "application/problem+json": { "schema": { "$ref": "#/components/schemas/Problem" } } }
      },
      "NotFound": {
        "description": "unknown product · unknown table · unknown vocabulary — 비공개 제품도 404 로 답한다(403 이면 존재 여부를 알려주는 셈이라서)",
        "content": { "application/problem+json": { "schema": { "$ref": "#/components/schemas/Problem" } } }
      },
      "Conflict": {
        "description": "cursor expired(재발행) · pattern not verified(verified_at 없음 — runnable=false 인 패턴) · rotate confirmation required(기존 키 존재)",
        "content": { "application/problem+json": { "schema": { "$ref": "#/components/schemas/Problem" } } }
      },
      "TooManyRequests": {
        "description": "burst rate limited(분당 60) · daily quota exceeded(일 1000) · issuance rate limited(발급 IP당 시간당 5)",
        "headers": {
          "Retry-After": { "schema": { "type": "integer" }, "description": "분당 한도 초과 시에만 내려간다" }
        },
        "content": { "application/problem+json": { "schema": { "$ref": "#/components/schemas/Problem" } } }
      }
    }
  }
}
