{
  "openapi": "3.1.0",
  "info": {
    "title": "seoul-urban-analytics K-Skill API",
    "version": "1.0.0-draft",
    "summary": "K-Skill 등록 심사용 서울 도시 분석 데이터 제품 계약",
    "description": "seoul-urban-analytics K-Skill만을 위한 읽기 전용 API다. 공용 Marketplace /v1 API와 제품 범위·응답 계약은 분리하지만, 같은 API Key·버스트 제한·오류·요청 추적 정책을 사용한다. 출처·이용권리·품질 증거가 Publisher에서 게시되기 전에는 데이터 행을 반환하지 않고 503 product_not_ready로 실패한다."
  },
  "servers": [{ "url": "/", "description": "이 서비스가 서빙 중인 호스트" }],
  "security": [{ "bearerAuth": [] }],
  "paths": {
    "/skill/v1/bundles/seoul-urban-analytics": {
      "get": {
        "summary": "K-Skill의 정확한 6개 제품 준비 상태",
        "operationId": "getSeoulUrbanAnalyticsBundle",
        "responses": {
          "200": {
            "description": "제품별 registration_ready와 blockers",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Bundle" } } }
          },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "429": { "$ref": "#/components/responses/TooManyRequests" }
        }
      }
    },
    "/skill/v1/products/{product_id}": {
      "get": {
        "summary": "한 제품의 발행·구조·컬럼 증거와 준비 상태",
        "operationId": "getSeoulUrbanAnalyticsProduct",
        "parameters": [{ "$ref": "#/components/parameters/ProductId" }],
        "responses": {
          "200": {
            "description": "제품 메타데이터. 이전 발행본 보조 메타는 metadata.meta_of=previous_publication으로 표시한다.",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Product" } } }
          },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "404": { "$ref": "#/components/responses/NotFound" },
          "429": { "$ref": "#/components/responses/TooManyRequests" }
        }
      }
    },
    "/skill/v1/products/{product_id}/data": {
      "get": {
        "summary": "준비된 제품의 데이터 조회",
        "description": "현재 출처·이용권리·품질 메타 계약이 미게시 상태이므로 모든 제품은 503 product_not_ready를 반환한다. 이 응답은 빈 데이터 집합이 아니다. 해당 증거 계약과 publication-bound cursor 계약이 준비된 뒤에만 200 데이터 페이지를 활성화한다.",
        "operationId": "getSeoulUrbanAnalyticsData",
        "parameters": [{ "$ref": "#/components/parameters/ProductId" }],
        "responses": {
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "404": { "$ref": "#/components/responses/NotFound" },
          "429": { "$ref": "#/components/responses/TooManyRequests" },
          "503": { "$ref": "#/components/responses/ProductNotReady" }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "description": "Authorization: Bearer ask_… . 키 원문은 환경변수 또는 사용자 로컬 secrets 파일에서 읽고 URL·로그·채팅에 넣지 않는다."
      }
    },
    "parameters": {
      "ProductId": {
        "name": "product_id",
        "in": "path",
        "required": true,
        "schema": {
          "type": "string",
          "enum": [
            "weather_place_forecast_change_daily",
            "traffic_incident_x_weather_current_hourly",
            "citydata_purchasing_power_daily",
            "commerce_flow_monthly",
            "culture_activity_by_dong",
            "transit_parking_full_risk"
          ]
        }
      }
    },
    "schemas": {
      "Bundle": {
        "type": "object",
        "required": ["bundle_id", "registration_ready", "products"],
        "properties": {
          "bundle_id": { "const": "seoul-urban-analytics" },
          "registration_ready": { "type": "boolean" },
          "products": { "type": "array", "items": { "$ref": "#/components/schemas/ProductReadiness" } }
        }
      },
      "ProductReadiness": {
        "type": "object",
        "required": ["product_id", "registration_ready", "blockers"],
        "properties": {
          "product_id": { "type": "string" },
          "publication_id": { "type": ["string", "null"] },
          "registration_ready": { "type": "boolean" },
          "blockers": { "type": "array", "items": { "type": "string" } }
        }
      },
      "Product": {
        "allOf": [
          { "$ref": "#/components/schemas/ProductReadiness" },
          {
            "type": "object",
            "required": ["bundle_id", "metadata"],
            "properties": {
              "bundle_id": { "const": "seoul-urban-analytics" },
              "metadata": {
                "type": "object",
                "properties": {
                  "publication_id": { "type": ["string", "null"] },
                  "meta_of": { "type": ["string", "null"], "enum": ["previous_publication", null] },
                  "structure": { "type": ["object", "null"] },
                  "columns": { "type": "array", "items": { "type": "object" } }
                }
              }
            }
          }
        ]
      },
      "Problem": {
        "type": "object",
        "properties": {
          "type": { "type": "string" },
          "title": { "type": "string" },
          "status": { "type": "integer" },
          "detail": { "type": "string" },
          "code": { "type": "string" },
          "product_id": { "type": "string" },
          "blockers": { "type": "array", "items": { "type": "string" } },
          "request_id": { "type": "string" }
        }
      }
    },
    "responses": {
      "Unauthorized": { "description": "누락되었거나 알 수 없는 API Key", "content": { "application/problem+json": { "schema": { "$ref": "#/components/schemas/Problem" } } } },
      "Forbidden": { "description": "폐기된 API Key", "content": { "application/problem+json": { "schema": { "$ref": "#/components/schemas/Problem" } } } },
      "NotFound": { "description": "번들에 없는 제품", "content": { "application/problem+json": { "schema": { "$ref": "#/components/schemas/Problem" } } } },
      "TooManyRequests": { "description": "공유 버스트 제한 초과", "content": { "application/problem+json": { "schema": { "$ref": "#/components/schemas/Problem" } } } },
      "ProductNotReady": { "description": "필수 신뢰성 증거 또는 데이터 조회 계약이 준비되지 않음", "content": { "application/problem+json": { "schema": { "$ref": "#/components/schemas/Problem" } } } }
    }
  }
}
