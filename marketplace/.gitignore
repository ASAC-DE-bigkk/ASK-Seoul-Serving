node_modules/
.wrangler/
# 픽스처 생성기를 import 해 돌릴 때 생긴다 — 산출물은 seed.sql·product-display.json 뿐이다
__pycache__/
# 운영자 토큰 등 로컬 시크릿 — 절대 커밋하지 않는다
.dev.vars
# Cloudflare CLI 자격증명(원격 D1·배포) — 절대 커밋 금지.
# .env.example 은 값이 빈 견본이라 추적한다.
.env
.env.*
!.env.example

# 모델 실측 산출물 — 매 실행마다 달라지는 값이라 레포에 남길 것이 아니다.
# (PowerShell `>` 는 UTF-16 으로 쓰기까지 해서 diff 로도 못 읽는다.)
eval*.md
